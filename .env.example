APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-local-secret
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Africa/Nairobi

# Use SQLite locally by leaving DATABASE_URL empty.
DATABASE_URL=

# Production background tasks use Redis/Celery.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
BACKGROUND_TASK_BACKEND=threading
DJANGO_SETTINGS_MODULE=config.settings.development

# Cloudinary media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_IMPORT_UPLOAD_SIZE=2097152

# M-Pesa Daraja settings.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_TOKEN=

# Email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Aptitude Kenya <no-reply@aptitude-kenya.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
